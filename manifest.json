{
  "manifest_version": 3,
  "name": "Solid JSON Viewer",
  "short_name": "JSON Viewer",
  "version": "0.0.2",
  "description": "Shows JSON, JSON-LD and JSON Lines responses as a tree, a table and raw text. No network requests, no data collected.",
  "author": "Melvin Carvalho",
  "homepage_url": "https://solid-panes.github.io/json/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["json-pane.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "json-viewer@solid-panes.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
